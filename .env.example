# ── Dify Workflow AI 代理配置 ──
# 将本文件重命名为 .env 后，运行加密工具把明文 Key 转为密文：
#   python tools/encrypt_env.py
# 脚本会：生成 SECRET_KEY → 写入独立文件 secret_key（权限 600）→ 把 .env 中的
# API Key 加密为 enc: 形式 → 删除 .env 里的 SECRET_KEY。
#
# SECRET_KEY 设置方式（三选一，不要写进 .env，避免与密文同源）：
#   macOS/Linux: export SECRET_KEY="$(cat secret_key)"
#   Windows:     set SECRET_KEY=xxx
#   或：保持 secret_key 文件与 .env 同级，启动脚本（start.sh / start.command）自动注入

# Dify 主 Workflow（SQL 生成、字段映射、报表识别、AI 差异分析 等）
DIFY_MAIN_BASE_URL=https://your-dify-server/v1
DIFY_MAIN_API_KEY=enc:gAAAAAB...            # 示例占位，由 tools/encrypt_env.py 生成

# Dify 复核 Workflow（SQL 代码复核审查）
DIFY_REVIEW_BASE_URL=https://your-dify-server/v1
DIFY_REVIEW_API_KEY=enc:gAAAAAB...          # 示例占位，由 tools/encrypt_env.py 生成

# ── 兼容：明文 Key 仍可直接使用（旧 .env 无需改动即可运行，但不推荐）──
# 直接把明文 key 写在这里，不配置 SECRET_KEY 也能运行：
# DIFY_MAIN_API_KEY=app-your-main-api-key

# 注意：SECRET_KEY 不要写在这里（见上方说明）。
